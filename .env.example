# 双连接串(07 §8):运行时永远用 app_runtime,DDL 永远用 migrator。
# 两串指向同一库,区别只在身份 —— append-only 靠权限兜底,不靠纪律(01 §1)。
#
# Prisma 7 不再自动加载 .env(官方:"no longer automatically loading environment
# variables when invoking the Prisma CLI"),且 datasource.url 搬进 prisma.config.ts。
# 绑定关系(P0-T3 落地):
#   prisma.config.ts 首行 import "dotenv/config"
#   datasource.url            <- MIGRATOR_DATABASE_URL   (CLI / migrate 用)
#   new PrismaPg({ connectionString: process.env.DATABASE_URL })  (运行时用)
#
# 注意两条串**语义不对称**:MIGRATOR_ 那条走 Rust schema engine,`?schema=` 生效;
# DATABASE_URL 走 @prisma/adapter-pg → node-postgres,`?schema=` 会被**静默丢弃**
# (pg 的参数白名单里没有 schema;Prisma issue #28128 已确认未修)。运行时要指定
# schema 必须走第二个构造参数:new PrismaPg({ connectionString }, { schema: "..." })。
# 故这里不写 ?schema=,免得长得像生效的样子。
DATABASE_URL="postgresql://app_runtime:app_runtime@127.0.0.1:5432/stocksteer"
MIGRATOR_DATABASE_URL="postgresql://migrator:migrator@127.0.0.1:5432/stocksteer?schema=public"

# 30 天物理删除专用身份(拍板点⑥)。对三张事件表有 SELECT + DELETE,别的一律没有。
# purge job 只有删事件行那一步换这条串,其余步骤仍走 DATABASE_URL。
PURGER_DATABASE_URL="postgresql://app_purger:app_purger@127.0.0.1:5432/stocksteer"

REDIS_URL="redis://127.0.0.1:6379"

# 本地 compose 建角色时用;不设则回落到与用户名同名的开发口令。
# 改这两个值必须同时改上面两条串,且要 `pnpm db:reset`——init 只在空卷时跑,
# 否则库里还是旧口令、连接串却已换新。
# 生产口令不走这里,见 P0-T5。
MIGRATOR_PASSWORD="migrator"
APP_RUNTIME_PASSWORD="app_runtime"
PURGER_PASSWORD="app_purger"
